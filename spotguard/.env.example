# Copy to .env (never commit it). Nothing here is required for paper mode or offline replay.

# --- Screening providers (optional; without them screening returns UNKNOWN, which blocks entries) ---
# GoPlus access token if you have one (free access is not assumed; rate limits apply)
GOPLUS_ACCESS_TOKEN=
# Solana RPC (defaults to the public endpoint, which is slow and rate limited)
SOLANA_RPC_URL=
# EVM RPC per chain id, e.g. EVM_RPC_URL_1 for Ethereum, EVM_RPC_URL_8453 for Base
EVM_RPC_URL_1=

# --- Dashboard: only needed to bind beyond localhost (min. 24 random characters) ---
SPOTGUARD_DASHBOARD_TOKEN=

# --- LIVE trading: disabled. Do not fill these in until every item in README "Before any live setup" is done. ---
# Coinbase CDP API key: trade permission only, withdrawals DISABLED, IP allowlist set.
# Provide these from a secret manager or your shell at runtime, not from a file in source control.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
# Must equal I_ACCEPT_REAL_MONEY_RISK together with mode=live and a valid approval file to enable live.
SPOTGUARD_LIVE_ENABLE=
